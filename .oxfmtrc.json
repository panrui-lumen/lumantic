{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 120,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"sortTailwindcss": {
		"stylesheet": "./src/react-app/index.css",
		"functions": ["clsx", "cn"]
	},
	"ignorePatterns": [
		"dist/**",
		".wrangler/**",
		"coverage/**",
		"test-results/**",
		"playwright-report/**",
		"blob-report/**",
		"playwright/.cache/**",
		"package-lock.json",
		"worker-configuration.d.ts",
		"node_modules/**"
	]
}
