{
	"extends": "./tsconfig.node.json",
	"compilerOptions": {
		"types": ["jest", "node"],
		"module": "CommonJS",
		"moduleResolution": "node",
		"verbatimModuleSyntax": false,
		"noEmit": true,
		"isolatedModules": true
	},
	"include": [
		"src/shared/**/*.ts",
		"src/react-app/appVersion.ts",
		"src/react-app/chatComposerDraft.ts",
		"src/**/__tests__/**/*.ts",
		"scripts/vite-app-version-plugin.ts"
	]
}
